# ============================================================
# MT5 Proxy — Environment Variables
# ============================================================
#
# คัดลอกไฟล์นี้ไปเป็น .env แล้วแก้ค่าให้ตรง
#
# ⚠️  NEVER commit .env to git!
#     ไฟล์ .env.example นี้ safe — เป็นแค่ template
# ============================================================


# ── SHARED KEYS (ต้องตรงกันทั้ง Linux + Windows) ──────────

# API Key สำหรับ authenticate requests
# สร้าง: python -c "import secrets; print(secrets.token_urlsafe(32))"
MT5_PROXY_API_KEY=CHANGE-ME-generate-a-random-key

# HMAC Secret สำหรับ sign /execute, /flatten requests
# สร้าง: python -c "import secrets; print(secrets.token_urlsafe(32))"
MT5_PROXY_HMAC_SECRET=CHANGE-ME-generate-another-random-key


# ============================================================
# LINUX VPS SIDE (engine) — ใส่ใน .env ของ Linux
# ============================================================

# URL ของ Windows VPS ที่รัน mt5_proxy_server.py
# ⚠️  production: ใช้ HTTPS!
MT5_PROXY_URL=https://YOUR_WINDOWS_VPS_IP:8500


# ============================================================
# WINDOWS VPS SIDE (proxy) — ใส่ใน .env ของ Windows
# ============================================================

# ── MT5 Terminal Login
MT5_LOGIN=12345678
MT5_PASSWORD=your-mt5-password
MT5_SERVER=FTMO-Server

# Path ไปยัง MT5 Terminal (optional — ถ้า default ก็ไม่ต้องใส่)
# MT5_PATH=C:\Program Files\FTMO MetaTrader 5\terminal64.exe

# ── Server Settings
MT5_PROXY_HOST=0.0.0.0
MT5_PROXY_PORT=8500

# ── IP Whitelist — เฉพาะ IP ของ Linux VPS
# ใส่ "*" สำหรับ dev mode (ไม่แนะนำ production)
MT5_PROXY_ALLOWED_IPS=YOUR_LINUX_VPS_IP

# ── Rate Limit
MT5_PROXY_RATE_LIMIT=30

# ── Symbol Map Override (optional — JSON string)
# ใช้ถ้า FTMO broker ใช้ชื่อ symbol ไม่ตรง default
# MT5_SYMBOL_MAP={"US30":"US30","NAS100":"USTEC","XAUUSD":"GOLD"}
